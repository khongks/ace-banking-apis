/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();

		-- Retrieve customerId from the HTTP path parameter
		DECLARE v_CustomerId CHARACTER InputLocalEnvironment.REST.Input.Parameters.customerId;

		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';

		-- Query customer by ID from PostgreSQL via ODBC datasource MY_PG_DSN
		DECLARE customer ROW;
		SET customer.Record[] = SELECT
			C.customer_id   AS CustomerId,
			C.first_name    AS FirstName,
			C.last_name     AS LastName,
			C.email         AS Email,
			C.phone         AS Phone,
			C.date_of_birth AS DateOfBirth,
			C.status        AS Status
		FROM Database.{DBSchema}.{DBTable} AS C
		WHERE C.customer_id = v_CustomerId;

		-- SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		IF (SQLCODE = 0) THEN
			IF CARDINALITY(customer.Record[]) > 0 THEN
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
				SET outputDataRef.CustomerId  = customer.Record[1].CustomerId;
				SET outputDataRef.FirstName   = customer.Record[1].FirstName;
				SET outputDataRef.LastName    = customer.Record[1].LastName;
				SET outputDataRef.Email       = customer.Record[1].Email;
				SET outputDataRef.Phone       = customer.Record[1].Phone;
				SET outputDataRef.DateOfBirth = customer.Record[1].DateOfBirth;
				SET outputDataRef.Status      = customer.Record[1].Status;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET outputDataRef.error   = 'Not found';
				SET outputDataRef.message = 'Customer ' || v_CustomerId || ' not found';
			END IF;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.error   = 'SQL Error';
			SET outputDataRef.message = 'Select operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;

		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
