/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context downstream
		CALL CopyMessageHeaders();
		
		-- Extract request body fields
		DECLARE reqRef REFERENCE TO InputRoot.JSON.Data;
		DECLARE v_FirstName   CHARACTER CAST(reqRef.FirstName   AS CHARACTER);
		DECLARE v_LastName    CHARACTER CAST(reqRef.LastName    AS CHARACTER);
		DECLARE v_Email       CHARACTER CAST(reqRef.Email       AS CHARACTER);
		DECLARE v_Phone       CHARACTER CAST(reqRef.Phone       AS CHARACTER);
		DECLARE v_DateOfBirth CHARACTER CAST(reqRef.DateOfBirth AS CHARACTER);
		DECLARE v_Status      CHARACTER CAST(reqRef.Status      AS CHARACTER);
		DECLARE v_CustomerId  CHARACTER;

		-- Generate CustomerId: CUS-YYMMDDHHMM
		SET v_CustomerId = 'CUS-' || SUBSTRING(CAST(EXTRACT(YEAR  FROM CURRENT_TIMESTAMP) AS CHARACTER) FROM 3 FOR 2)
		                           || RIGHT('0' || CAST(EXTRACT(MONTH  FROM CURRENT_TIMESTAMP) AS CHARACTER), 2)
		                           || RIGHT('0' || CAST(EXTRACT(DAY    FROM CURRENT_TIMESTAMP) AS CHARACTER), 2)
		                           || RIGHT('0' || CAST(EXTRACT(HOUR   FROM CURRENT_TIMESTAMP) AS CHARACTER), 2)
		                           || RIGHT('0' || CAST(EXTRACT(MINUTE FROM CURRENT_TIMESTAMP) AS CHARACTER), 2);

		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';

		-- Insert new customer into PostgreSQL via ODBC datasource MY_PG_DSN
		INSERT INTO Database.{DBSchema}.{DBTable}
			(customer_id, first_name, last_name, email, phone, date_of_birth, status)
		VALUES
			(v_CustomerId, v_FirstName, v_LastName, v_Email, v_Phone, v_DateOfBirth, v_Status);

		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;
		

		IF (SQLCODE = 0) THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '201';
			SET OutputRoot.JSON.Data.Result = 'A row was inserted into the database successfully.';
			SET OutputRoot.JSON.Data.Customer.CustomerId  = v_CustomerId;
			SET OutputRoot.JSON.Data.Customer.FirstName   = v_FirstName;
			SET OutputRoot.JSON.Data.Customer.LastName    = v_LastName;
			SET OutputRoot.JSON.Data.Customer.Email       = v_Email;
			SET OutputRoot.JSON.Data.Customer.Phone       = v_Phone;
			SET OutputRoot.JSON.Data.Customer.DateOfBirth = v_DateOfBirth;
			SET OutputRoot.JSON.Data.Customer.Status      = v_Status;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET OutputRoot.JSON.Data.error   = 'SQL Error';
			SET OutputRoot.JSON.Data.message = 'Insert operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;

		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
