/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract optional query parameter filters
		DECLARE accountIdFilter CHAR InputLocalEnvironment.REST.Input.Parameters.accountId;
		DECLARE statusFilter CHAR InputLocalEnvironment.REST.Input.Parameters.status;
		
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'transactions';

		-- 3. Query PostgreSQL based on filters
		DECLARE transaction ROW;
		IF accountIdFilter IS NOT NULL AND accountIdFilter <> '' AND statusFilter IS NOT NULL AND statusFilter <> '' THEN
			SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			                           WHERE T.account_id = accountIdFilter AND T.status = statusFilter;
		ELSEIF accountIdFilter IS NOT NULL AND accountIdFilter <> '' THEN
			SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			                           WHERE T.account_id = accountIdFilter;
		ELSEIF statusFilter IS NOT NULL AND statusFilter <> '' THEN
			SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			                           WHERE T.status = statusFilter;
		ELSE
			SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T;
		END IF;
		
		-- 4. Initialize HTTP response status and explicit JSON Array structure
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
		CREATE FIELD OutputRoot.JSON.Data IDENTITY (JSON.Array)Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;
		
		-- 5. Safe traversal loop using REFERENCE and NEXTSIBLING NAME
		DECLARE outIndex INT 1;
		DECLARE refTx REFERENCE TO txRows.Transaction[1];
		WHILE LASTMOVE(refTx) DO
			SET outputDataRef.Item[outIndex].transactionId = COALESCE(refTx.transaction_id, refTx.TRANSACTION_ID);
			SET outputDataRef.Item[outIndex].accountId = COALESCE(refTx.account_id, refTx.ACCOUNT_ID);
			SET outputDataRef.Item[outIndex].amount = COALESCE(refTx.amount, refTx.AMOUNT);
			SET outputDataRef.Item[outIndex].currency = COALESCE(refTx.currency, refTx.CURRENCY);
			SET outputDataRef.Item[outIndex].transactionType = COALESCE(refTx.transaction_type, refTx.TRANSACTION_TYPE);
			SET outputDataRef.Item[outIndex].status = COALESCE(refTx.status, refTx.STATUS);
			SET outputDataRef.Item[outIndex].description = COALESCE(refTx.description, refTx.DESCRIPTION);
			SET outputDataRef.Item[outIndex].createdDate = COALESCE(refTx.created_date, refTx.CREATED_DATE);
			SET outputDataRef.Item[outIndex].updatedDate = COALESCE(refTx.updated_date, refTx.UPDATED_DATE);
			
			SET outIndex = outIndex + 1;
			MOVE refTx NEXTSIBLING NAME 'Transaction';
		END WHILE;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
