/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract path parameter
		DECLARE v_TransactionId CHAR InputLocalEnvironment.REST.Input.Parameters.transactionId;
		
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'transactions';

		-- 3. Query PostgreSQL for single matching transaction
		DECLARE transaction ROW;
		SET transaction = THE(
			SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			WHERE T.transaction_id = v_TransactionId
		);
		
		-- 4. Check if record exists
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		IF transaction.transaction_id IS NOT NULL OR transaction.TRANSACTION_ID IS NOT NULL THEN
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
			
			SET outputDataRef.transactionId = COALESCE(transaction.transaction_id, transaction.TRANSACTION_ID);
			SET outputDataRef.accountId = COALESCE(transaction.account_id, transaction.ACCOUNT_ID);
			SET outputDataRef.amount = COALESCE(transaction.amount, transaction.AMOUNT);
			SET outputDataRef.currency = COALESCE(transaction.currency, transaction.CURRENCY);
			SET outputDataRef.transactionType = COALESCE(transaction.transaction_type, transaction.TRANSACTION_TYPE);
			SET outputDataRef.status = COALESCE(transaction.status, transaction.STATUS);
			SET outputDataRef.description = COALESCE(transaction.description, transaction.DESCRIPTION);
			SET outputDataRef.createdDate = COALESCE(transaction.created_date, transaction.CREATED_DATE);
			SET outputDataRef.updatedDate = COALESCE(transaction.updated_date, transaction.UPDATED_DATE);
		ELSE
			-- Transaction not found (HTTP 404)
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 404;			
			
			SET outputDataRef.error = 'Transaction Not Found';
			SET outputDataRef.message = 'The transactionId ' || v_TransactionId || ' does not exist.';
		END IF;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
