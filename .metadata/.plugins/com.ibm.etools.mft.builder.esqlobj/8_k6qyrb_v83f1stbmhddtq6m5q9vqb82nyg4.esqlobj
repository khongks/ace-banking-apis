/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- Retrieve accountId from the HTTP path parameter
		DECLARE v_AccountId CHARACTER InputLocalEnvironment.REST.Input.Parameters.accountId;

		-- Extract request body fields
		DECLARE reqRef REFERENCE TO InputRoot.JSON.Data;		
		DECLARE v_CustomerName CHARACTER CAST(reqRef.CustomerName AS CHARACTER);
		DECLARE v_AccountType  CHARACTER CAST(reqRef.AccountType  AS CHARACTER);
		DECLARE v_Balance      DECIMAL CAST(reqRef.Balance      AS DECIMAL);
		DECLARE v_Currency     CHARACTER CAST(reqRef.Currency     AS CHARACTER);
		DECLARE v_Status       CHARACTER CAST(reqRef.Status       AS CHARACTER);
		DECLARE v_AccountId    CHARACTER;

		DECLARE v_CustomerName CHARACTER;
		DECLARE v_AccountType  CHARACTER;
		DECLARE v_Balance      DECIMAL;
		DECLARE v_Currency     CHARACTER;
		DECLARE v_Status       CHARACTER;

		DECLARE account 	  	ROW;

		SET v_CustomerName = CAST(reqRef.CustomerName AS CHARACTER);
		SET v_AccountType  = CAST(reqRef.AccountType  AS CHARACTER);
		SET v_Balance      = CAST(reqRef.Balance      AS DECIMAL);
		SET v_Currency     = CAST(reqRef.Currency     AS CHARACTER);
		SET v_Status       = CAST(reqRef.Status       AS CHARACTER);
		
		-- DECLARE DBSchema CHARACTER 'public';	
		-- DECLARE DBTable  CHARACTER 'accounts';

		-- Update account in PostgreSQL via ODBC datasource MY_PG_DSN
		UPDATE Database.public.accounts AS A
			SET customer_name = v_CustomerName,
			    account_type  = v_AccountType,
			    balance       = v_Balance,
			    currency      = v_Currency,
			    status        = v_Status
			WHERE A.account_id = v_AccountId;

		SET OutputRoot.Properties = InputRoot.Properties;			
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;
		IF (SQLCODE = 0) THEN
			SET OutputRoot.JSON.Data.AccountId    = v_AccountId;
			SET OutputRoot.JSON.Data.CustomerName = v_CustomerName;
			SET OutputRoot.JSON.Data.AccountType  = v_AccountType;
			SET OutputRoot.JSON.Data.Balance      = v_Balance;
			SET OutputRoot.JSON.Data.Currency     = v_Currency;
			SET OutputRoot.JSON.Data.Status       = v_Status;		
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';			
			SET OutputRoot.JSON.Data.error   = 'SQL Error';
            SET OutputRoot.JSON.Data.message = 'Update operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR); 
		END IF;
		RETURN TRUE;
	END;
