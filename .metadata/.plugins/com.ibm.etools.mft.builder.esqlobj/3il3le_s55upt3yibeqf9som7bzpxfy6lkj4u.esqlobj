CREATE COMPUTE MODULE listCustomers_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract optional query parameter filters
		DECLARE statusFilter CHAR InputLocalEnvironment.REST.Input.Parameters.status;

		-- 3. Reference Output JSON Array
		CREATE FIELD OutputRoot.JSON.Data IDENTITY (JSON.Array)Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		-- 4. Query database based on filters
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';
		
		IF statusFilter IS NOT NULL AND statusFilter <> '' THEN
			SET outputDataRef.Item[] = SELECT
				C.customer_id   AS customerId,
				C.first_name    AS firstName,
				C.last_name     AS lastName,
				C.email         AS email,
				C.phone         AS phone,
				C.date_of_birth AS dateOfBirth,
				C.status        AS status
			FROM Database.{DBSchema}.{DBTable} AS C WHERE T.status = statusFilter;
		ELSE
		END IF;


		IF (SQLCODE = 0) THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
			RETURN TRUE;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET OutputRoot.JSON.Data.error   = 'SQL Error';
			SET OutputRoot.JSON.Data.message = 'Select operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;

		RETURN TRUE;
	END;
	
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;