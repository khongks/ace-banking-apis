CREATE COMPUTE MODULE createCustomer_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context downstream
		CALL CopyMessageHeaders();

		-- 2. Reference Input JSON Data
		DECLARE inputDataRef REFERENCE TO InputRoot.JSON.Data;
		
		-- 3. Reference Output JSON Data
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		-- 4. Check JSON Data Exist
		IF NOT LASTMOVE(inputDataRef) THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.status = 'Bad Request';
			SET outputDataRef.message = 'No JSON data found in input message.';
			RETURN TRUE;
		END IF;
				
		-- 5. Extract and map input data fields using FIELDVALUE
		DECLARE v_FirstName   CHARACTER FIELDVALUE(inputDataRef.firstName);
		DECLARE v_LastName    CHARACTER FIELDVALUE(inputDataRef.lastName);
		DECLARE v_Email       CHARACTER FIELDVALUE(inputDataRef.email);
		DECLARE v_Phone       CHARACTER FIELDVALUE(inputDataRef.phone);
		DECLARE v_DateOfBirth CHARACTER FIELDVALUE(inputDataRef.dateOfBirth);
		DECLARE v_Status      CHARACTER FIELDVALUE(inputDataRef.status);
		DECLARE v_CustomerId  CHARACTER;
		
		-- 6. Validate mandatory and enum fields
		IF v_FirstName IS NULL OR v_FirstName = '' THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.message = 'firstName is required';
			RETURN TRUE;
		END IF;

		IF v_LastName IS NULL OR v_LastName = '' THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.message = 'lastName is required';
			RETURN TRUE;
		END IF;
		
		IF v_Email IS NULL OR v_Email = '' THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.message = 'email is required';
			RETURN TRUE;
		END IF;

		IF v_Phone IS NULL OR v_Phone = '' THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.message = 'phone is required';
			RETURN TRUE;
		END IF;
		
		IF v_DateOfBirth IS NULL OR v_DateOfBirth = '' THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.message = 'dateOfBirth is required';
			RETURN TRUE;
		END IF;	
		
		IF v_Status IS NULL OR v_Status = '' THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.message = 'status is required';
			RETURN TRUE;
		END IF;	


		-- Generate CustomerId
		DECLARE part1 CHARACTER CAST(CAST(RAND() * 899999 + 100000 AS INTEGER) AS CHARACTER);
		DECLARE part2 CHARACTER CAST(CAST(RAND() * 899999 + 100000 AS INTEGER) AS CHARACTER);
		SET v_CustomerId = 'CUS-' || part1 || part2;

		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';

		-- Insert new customer into PostgreSQL via ODBC datasource MY_PG_DSN
		INSERT INTO Database.{DBSchema}.{DBTable}
			(customer_id, first_name, last_name, email, phone, date_of_birth, status)
		VALUES
			(v_CustomerId, v_FirstName, v_LastName, v_Email, v_Phone, v_DateOfBirth, v_Status);

		IF (SQLCODE = 0) THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '201';
			SET outputDataRef.status = 'success';
			SET outputDataRef.message = 'Customer ' || v_CustomerId || ' created successfully.';
			SET outputDataRef.customer.customerId  	= v_CustomerId;
			SET outputDataRef.customer.firstName   	= v_FirstName;
			SET outputDataRef.customer.lastName    	= v_LastName;
			SET outputDataRef.customer.email       	= v_Email;
			SET outputDataRef.customer.phone        = v_Phone;
			SET outputDataRef.customer.dateOfBirth 	= v_DateOfBirth;
			SET outputDataRef.customer.status      	= v_Status;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.error   = 'SQL Error';
			SET outputDataRef.message = 'Insert failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;