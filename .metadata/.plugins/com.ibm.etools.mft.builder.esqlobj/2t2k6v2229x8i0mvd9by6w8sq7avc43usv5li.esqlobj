CREATE COMPUTE MODULE getTransaction_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract path parameter
		DECLARE v_TransactionId CHAR InputLocalEnvironment.REST.Input.Parameters.transactionId;
		
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'transactions';

		-- 3. Query PostgreSQL for single matching transaction
		DECLARE transaction ROW;
		SET transaction.Record[] = SELECT
			T.transaction_id 	AS transaction_id,
			T.account_id 		AS account_id,
			T.amount 			AS amount,
			T.currency 			AS currency,
			T.transaction_type 	AS transaction_type,
			T.status 			AS status,
			T.description 		AS description,
			T.created_date 		AS created_date,
			T.updated_date 		AS updated_date
		FROM Database.{DBSchema}.{DBTable} AS T
		WHERE T.transaction_id = v_TransactionId;
		
		-- 4. Reference Output JSON Data
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;
		
		IF (SQLCODE = 0) THEN
			IF CARDINALITY(transaction.Record[]) > 0 THEN
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
				SET outputDataRef.transactionId 	= transaction.Record[1].transaction_id;
				SET outputDataRef.accountId 		= transaction.Record[1].account_id;
				SET outputDataRef.amount 			= transaction.Record[1].amount;
				SET outputDataRef.currency 			= transaction.Record[1].currency;
				SET outputDataRef.transactionType 	= transaction.Record[1].transaction_type;
				SET outputDataRef.status 			= transaction.Record[1].status;
				SET outputDataRef.description 		= transaction.Record[1].description;
				SET outputDataRef.createdDate 		= transaction.Record[1].created_date;
				SET outputDataRef.updatedDate 		= transaction.Record[1].updated_date;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET outputDataRef.error   = 'Not found';
				SET outputDataRef.message = 'Transaction ' || v_TransactionId || ' not found';
			END IF;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.status   = 'SQL Error';
			SET outputDataRef.message = 'Select operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;