CREATE COMPUTE MODULE listTransactions_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract optional query parameter filters
		--  DECLARE accountIdFilter CHAR InputLocalEnvironment.REST.Input.Parameters.accountId;
		DECLARE statusFilter CHAR InputLocalEnvironment.REST.Input.Parameters.status;
		
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'transactions';

		-- 3. Query PostgreSQL based on filters
		DECLARE transaction ROW;
		-- IF accountIdFilter IS NOT NULL AND accountIdFilter <> '' AND statusFilter IS NOT NULL AND statusFilter <> '' THEN
		-- 	SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T
	    -- 		                           WHERE T.account_id = accountIdFilter AND T.status = statusFilter;
		-- ELSEIF accountIdFilter IS NOT NULL AND accountIdFilter <> '' THEN
		--	SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T
		-- 	                           WHERE T.account_id = accountIdFilter;
		IF statusFilter IS NOT NULL AND statusFilter <> '' THEN
			SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			                           WHERE T.status = statusFilter;
		ELSE
			SET transaction.Transaction[] = SELECT * FROM Database.{DBSchema}.{DBTable} AS T;
		END IF;
		
		-- 4. Initialize HTTP response status and explicit JSON Array structure
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
		CREATE FIELD OutputRoot.JSON.Data IDENTITY (JSON.Array)Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;
		
		-- 5. Safe traversal loop using REFERENCE and NEXTSIBLING NAME
		DECLARE outIndex INT 1;
		DECLARE refTransaction REFERENCE TO transaction.Transaction[1];
		WHILE LASTMOVE(refTransaction) DO
			SET outputDataRef.Item[outIndex].transactionId = refTransaction.transaction_id;
			SET outputDataRef.Item[outIndex].accountId = refTransaction.account_id;
			SET outputDataRef.Item[outIndex].amount = refTransaction.amount;
			SET outputDataRef.Item[outIndex].currency = refTransaction.currency;
			SET outputDataRef.Item[outIndex].transactionType = refTransaction.transaction_type;
			SET outputDataRef.Item[outIndex].status = refTransaction.status;
			SET outputDataRef.Item[outIndex].description = refTransaction.description;
			SET outputDataRef.Item[outIndex].createdDate = refTransaction.created_date;
			SET outputDataRef.Item[outIndex].updatedDate = refTransaction.updated_date;
			
			SET outIndex = outIndex + 1;
			MOVE refTransaction NEXTSIBLING NAME 'Transaction';
		END WHILE;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;