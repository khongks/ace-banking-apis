CREATE COMPUTE MODULE deleteAccount_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- Retrieve accountId from the HTTP path parameter
		DECLARE v_AccountId CHARACTER InputLocalEnvironment.REST.Input.Parameters.accountId;

		DECLARE v_RowCount INTEGER 0;

		-- Check account exists
		SET v_RowCount = CARDINALITY(SELECT ITEM a.account_id
			FROM Database.MY_PG_DSN.accounts AS a
			WHERE a.account_id = v_AccountId);

		IF v_RowCount = 0 THEN
			SET OutputRoot.Properties         = InputRoot.Properties;
			SET OutputRoot.HTTPResponseHeader.X-Original-HTTP-Status-Code = '404';
			CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
			CREATE FIELD OutputRoot.JSON.Data;
			SET OutputRoot.JSON.Data.error   = 'NOT_FOUND';
			SET OutputRoot.JSON.Data.message = 'Account ' || v_AccountId || ' not found';
			RETURN TRUE;
		END IF;

		-- Delete account from PostgreSQL via ODBC datasource MY_PG_DSN
		PASSTHRU('DELETE FROM accounts WHERE account_id = ?', v_AccountId)
			TO Database.MY_PG_DSN;

		-- Build JSON response
		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;

		SET OutputRoot.JSON.Data.message = 'Account ' || v_AccountId || ' deleted successfully';

		RETURN TRUE;
	END;
END MODULE;