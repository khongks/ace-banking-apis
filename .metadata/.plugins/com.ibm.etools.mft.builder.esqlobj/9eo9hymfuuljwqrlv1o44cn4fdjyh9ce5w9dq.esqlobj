/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract path parameter
		DECLARE v_TransactionId CHAR InputLocalEnvironment.REST.Input.Parameters.transactionId;
		
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'transactions';

		-- 3. Query PostgreSQL for single matching transaction
		DECLARE transaction ROW;
		SET transaction = THE(
			SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			WHERE T.transaction_id = v_TransactionId
		);
		
		-- 4. Check if record exists
		IF transaction.transaction_id IS NOT NULL OR txRow.TRANSACTION_ID IS NOT NULL THEN
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
			
			CREATE FIELD OutputRoot.JSON.Data;
			DECLARE outputData REFERENCE TO OutputRoot.JSON.Data;
			
			SET outputData.transactionId = COALESCE(txRow.transaction_id, txRow.TRANSACTION_ID);
			SET outputData.accountId = COALESCE(txRow.account_id, txRow.ACCOUNT_ID);
			SET outputData.amount = COALESCE(txRow.amount, txRow.AMOUNT);
			SET outputData.currency = COALESCE(txRow.currency, txRow.CURRENCY);
			SET outputData.transactionType = COALESCE(txRow.transaction_type, txRow.TRANSACTION_TYPE);
			SET outputData.status = COALESCE(txRow.status, txRow.STATUS);
			SET outputData.description = COALESCE(txRow.description, txRow.DESCRIPTION);
			SET outputData.createdDate = COALESCE(txRow.created_date, txRow.CREATED_DATE);
			SET outputData.updatedDate = COALESCE(txRow.updated_date, txRow.UPDATED_DATE);
		ELSE
			-- Transaction not found (HTTP 404)
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 404;
			
			CREATE FIELD OutputRoot.JSON.Data;
			DECLARE outputData REFERENCE TO OutputRoot.JSON.Data;
			
			SET outputData.error = 'Transaction Not Found';
			SET outputData.requested_id = transactionId;
			SET outputData.details = 'The transaction ID provided does not exist.';
		END IF;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
