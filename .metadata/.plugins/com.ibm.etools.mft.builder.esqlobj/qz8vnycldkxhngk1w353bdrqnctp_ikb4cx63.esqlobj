/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- Retrieve accountId from the HTTP path parameter
		DECLARE v_AccountId CHARACTER InputLocalEnvironment.REST.Input.Parameters.accountId;
		
		DECLARE account 	   ROW;
	    DECLARE refAccount REFERENCE TO account;

		DECLARE DBSchema CHARACTER 'public';	
		DECLARE DBTable  CHARACTER 'accounts';
		SET refAccount = ROW(SELECT * FROM Database.{DBSchema}.{DBTable} AS A WHERE A.account_id = v_AccountId);
		
		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;

		IF (SQLCODE = 0) THEN
			IF EXISTS(refAccount.*[]) THEN
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
				SET OutputRoot.JSON.Data.AccountId    = account.account_id;
				SET OutputRoot.JSON.Data.CustomerName = account.account_name;
				SET OutputRoot.JSON.Data.AccountType  = account.account_type;
				SET OutputRoot.JSON.Data.Balance      = account.balance;
				SET OutputRoot.JSON.Data.Currency     = account.currency;
				SET OutputRoot.JSON.Data.Status       = account.status;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET OutputRoot.JSON.Data.error   = 'Not found';
				SET OutputRoot.JSON.Data.message = 'Account ' || v_AccountId || ' not found';	
			END IF;
		ELSE
			-- Build JSON response with 500 status
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';			
			SET OutputRoot.JSON.Data.error   = 'SQL Error';
            SET OutputRoot.JSON.Data.message = 'The select failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR); 
		END IF;
		RETURN TRUE;
	END;
