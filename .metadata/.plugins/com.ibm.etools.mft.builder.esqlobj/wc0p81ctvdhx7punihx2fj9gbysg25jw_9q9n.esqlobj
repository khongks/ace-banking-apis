CREATE PROCEDURE SetHttpError(
    IN httpStatus INTEGER,
    IN errorCode CHARACTER,
    IN errorMessage CHARACTER
)
BEGIN
    SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = httpStatus;
    
    CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
    CREATE FIELD OutputRoot.JSON.Data;
    DECLARE errRef REFERENCE TO OutputRoot.JSON.Data;

    SET errRef.statusCode   = httpStatus;
    SET errRef.errorCode    = errorCode;
    SET errRef.errorMessage = errorMessage;
    SET errRef.timestamp    = CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSSZZZ');
END;