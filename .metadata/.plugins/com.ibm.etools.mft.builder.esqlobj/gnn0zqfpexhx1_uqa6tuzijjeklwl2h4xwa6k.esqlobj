/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Extract path parameter
		DECLARE v_TransactionId CHAR InputLocalEnvironment.REST.Input.Parameters.transactionId;
		
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'transactions';

		-- 3. Query PostgreSQL for single matching transaction
		DECLARE transaction ROW;
		SET transaction = THE(
			SELECT * FROM Database.{DBSchema}.{DBTable} AS T
			WHERE T.transaction_id = v_TransactionId
		);
		
		-- 4. Check if record exists
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		IF transaction.transaction_id IS NOT NULL THEN
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
			
			SET outputDataRef.TransactionId = transaction.transaction_id;
			SET outputDataRef.AccountId = transaction.account_id;
			SET outputDataRef.Amount = transaction.amount;
			SET outputDataRef.Currency = transaction.currency;
			SET outputDataRef.TransactionType = transaction.transaction_type;
			SET outputDataRef.Status = transaction.status;
			SET outputDataRef.Description = transaction.description;
			SET outputDataRef.CreatedDate = transaction.created_date;
			SET outputDataRef.UpdatedDate = transaction.updated_date;
		ELSE
			-- Transaction not found (HTTP 404)
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 404;			
			
			SET outputDataRef.error = 'Transaction Not Found';
			SET outputDataRef.message = 'The transactionId ' || transactionId || ' does not exist.';
		END IF;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
