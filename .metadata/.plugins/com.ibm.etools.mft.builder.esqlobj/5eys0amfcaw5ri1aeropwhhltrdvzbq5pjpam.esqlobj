/*EATE FUNCTION Main() RETURNS BOOLE*/
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();
		
		-- 2. Retrieve customerId from the HTTP path parameter
		DECLARE v_CustomerId CHARACTER InputLocalEnvironment.REST.Input.Parameters.customerId;

		-- 3. Reference Input JSON Data
		DECLARE inputDataRef REFERENCE TO InputRoot.JSON.Data;

		-- 4. Reference Output JSON Data
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		-- 5. Check JSON Data Exist
		IF NOT LASTMOVE(inputDataRef) THEN
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
			SET outputDataRef.status = 'Bad Request';
			SET outputDataRef.message = 'No JSON data found in input message.';
			RETURN TRUE;
		END IF;

		-- 6. Check if target transaction exists
		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';
		DECLARE customer ROW;
		SET customer.Record[] = SELECT
			C.customer_id 	AS customer_id,
			C.first_name AS first_id,
			C.last_name AS last_name,
			C.email AS email,
			C.phone AS phone,
			C.date_of_birth AS date_of_birth,
			C.status AS status
		FROM Database.{DBSchema}.{DBTable} AS C
		WHERE T.customer_id = v_CustomerId;
		
		IF (SQLCODE = 0) THEN
			IF CARDINALITY(customer.Record[]) > 0 THEN
				-- CONTINUE;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET outputDataRef.error = 'Customer not found';
				SET outputDataRef.message = 'The customerId ' || v_CustomerId || ' does not exist.';
				RETURN TRUE;
			END IF;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.error   = 'SQL Error';
			SET outputDataRef.message = 'Select operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
			RETURN TRUE;
		END IF;
		
		-- 7. Extract and map input data fields using FIELDVALUE
		DECLARE v_FirstName   CHARACTER FIELDVALUE(inputDataRef.firstName);
		DECLARE v_LastName    CHARACTER FIELDVALUE(inputDataRef.lastName);
		DECLARE v_Email       CHARACTER FIELDVALUE(inputDataRef.email);
		DECLARE v_Phone       CHARACTER FIELDVALUE(inputDataRef.phone);
		DECLARE v_DateOfBirth CHARACTER FIELDVALUE(inputDataRef.dateOfBirth);
		DECLARE v_Status      CHARACTER FIELDVALUE(inputDataRef.status);
		
		-- 8. Validate status if provided
		IF v_Status IS NOT NULL AND v_Status NOT IN ('ACTIVE', 'INACTIVE') THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '400';
			SET outputDataRef.error = 'Validation Error';
			SET outputDataRef.details = 'status must be ACTIVE or INACTIVE';
			RETURN TRUE;
		END IF;
		
		-- 10. Merge values: update specified fields, retain existing for omitted fields
		DECLARE finalFirstName CHARACTER COALESCE(v_FirstName, customer.first_name);
		DECLARE finalLastName DECIMAL COALESCE(v_LastName, customer.last_name);
		DECLARE finalEmail CHARACTER COALESCE(v_Email, customer.email);
		DECLARE finalPhone CHARACTER COALESCE(v_Phone, customer.phone);
		DECLARE finalDateOfBirth CHARACTER COALESCE(v_DateOfBirth, customer.date_of_birth);
		DECLARE finalStatus CHARACTER COALESCE(v_Status, customer.status);







	
		IF (SQLCODE = 0) THEN
			IF CARDINALITY(customer.Record[]) > 0 THEN
				UPDATE Database.{DBSchema}.{DBTable} AS C
					SET first_name    = v_FirstName,
					    last_name     = v_LastName,
					    email         = v_Email,
					    phone         = v_Phone,
					    date_of_birth = v_DateOfBirth,
					    status        = v_Status
					WHERE C.customer_id = v_CustomerId;		
					IF (SQLCODE = 0) THEN
						SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
						SET outputDataRef.status = 'success';
						SET outputDataRef.message = 'Customer ' || v_CustomerId || ' updated successfully.';
						SET outputDataRef.customer.customerId  = v_CustomerId;
						SET outputDataRef.customer.firstName   = v_FirstName;
						SET outputDataRef.customer.lastName    = v_LastName;
						SET outputDataRef.customer.email       = v_Email;
						SET outputDataRef.customer.phone       = v_Phone;
						SET outputDataRef.customer.dateOfBirth = v_DateOfBirth;
						SET outputDataRef.customer.status      = v_Status;	
					ELSE
						SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
						SET outputDataRef.error   = 'SQL Error';
						SET outputDataRef.message = 'Update operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
					END IF;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET outputDataRef.error = 'Not found';			
				SET outputDataRef.message = 'Customer ' || v_CustomerId || ' not found';
			END IF;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.error   = 'SQL Error';
			SET outputDataRef.message = 'Update operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;
		

	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
