CREATE COMPUTE MODULE getCustomer_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();

		-- 2. Retrieve customerId from the HTTP path parameter
		DECLARE v_CustomerId CHARACTER InputLocalEnvironment.REST.Input.Parameters.customerId;

		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';

		-- 3. Query customer by ID from PostgreSQL via ODBC datasource MY_PG_DSN
		DECLARE customer ROW;
		SET customer.Record[] = SELECT
			C.customer_id   AS customer_id,
			C.first_name    AS first_name,
			C.last_name     AS last_name,
			C.email         AS email,
			C.phone         AS phone,
			C.date_of_birth AS date_of_birth,
			C.status        AS status
		FROM Database.{DBSchema}.{DBTable} AS C
		WHERE C.customer_id = v_CustomerId;

		-- 4. SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		IF (SQLCODE = 0) THEN
			IF CARDINALITY(customer.Record[]) > 0 THEN
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
				SET outputDataRef.customerId  = customer.Record[1].customer_id;
				SET outputDataRef.firstName   = customer.Record[1].first_name;
				SET outputDataRef.lastName    = customer.Record[1].last_name;
				SET outputDataRef.email       = customer.Record[1].email;
				SET outputDataRef.phone       = customer.Record[1].phone;
				SET outputDataRef.dateOfBirth = customer.Record[1].date_of_birth;
				SET outputDataRef.status      = customer.Record[1].status;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET outputDataRef.error   = 'Not found';
				SET outputDataRef.message = 'Customer ' || v_CustomerId || ' not found';
			END IF;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.error   = 'SQL Error';
			SET outputDataRef.message = 'Insert operation failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;

		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
