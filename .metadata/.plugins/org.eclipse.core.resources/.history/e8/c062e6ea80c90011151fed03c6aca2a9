-- =============================================================================
-- PostgreSQL Database Schema for Transactions REST API
-- Project: Accounts
-- IBM App Connect Enterprise (ACE) / ESQL Integration
-- =============================================================================

-- 1. Create table public.transactions
CREATE TABLE IF NOT EXISTS public.accounts (
    account_id       VARCHAR(64)    NOT NULL,
    customer_id      VARCHAR(64)    NOT NULL,
    account_type     VARCHAR(20)    NOT NULL CHECK (transaction_type IN ('SAVINGS', 'CHECK', 'CREDIT')),
    balance          NUMERIC(20, 2) NOT NULL,
    currency         VARCHAR(3)     NOT NULL DEFAULT 'USD',
    status           VARCHAR(20)    NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'INACTIVE')),
    CONSTRAINT pk_transactions PRIMARY KEY (account_id)
);

-- 2. Indexes for query optimization
CREATE INDEX IF NOT EXISTS idx_accounts_customer_id 
    ON public.transactions(account_id);

CREATE INDEX IF NOT EXISTS idx_accounts_status 
    ON public.transactions(status);

