CREATE COMPUTE MODULE deleteCustomer_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();

		-- Retrieve customerId from the HTTP path parameter
		DECLARE v_CustomerId CHARACTER InputLocalEnvironment.REST.Input.Parameters.customerId;

		DECLARE DBSchema CHARACTER 'public';
		DECLARE DBTable  CHARACTER 'customers';
		
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;

		
		DECLARE customer ROW;
		SET customer.Record[] = SELECT
			T.customer_id 	AS customer_id
		FROM Database.{DBSchema}.{DBTable} AS T
		WHERE T.customer_id = v_CustomerId;
		
		IF (SQLCODE = 0) THEN
			IF CARDINALITY(transaction.Record[]) > 0 THEN
				DELETE FROM Database.{DBSchema}.{DBTable} AS C WHERE C.customer_id = v_CustomerId;
				IF (SQLCODE = 0) THEN
					SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '204';
					SET outputDataRef.status = 'success';			
					SET outputDataRef.message = 'Customer ' || v_CustomerId || ' deleted successfully';
				ELSE
					SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
					SET outputDataRef.error = 'SQL Error';			
					SET outputDataRef.message = 'Delete failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
				END IF;
			ELSE
				SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '404';
				SET outputDataRef.error = 'Not found';			
				SET outputDataRef.message = 'Customer ' || v_CustomerId || ' not found';
			END IF;
		ELSE
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			SET outputDataRef.error = 'SQL Error';			
			SET outputDataRef.message = 'Delete failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR);
		END IF;
		RETURN TRUE;
	END;
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
