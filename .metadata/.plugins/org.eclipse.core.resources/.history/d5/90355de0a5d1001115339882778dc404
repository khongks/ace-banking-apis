## Create
curl --request POST \
  --url http://{hostname}:7800/v1/accounts \
  --header 'accept: application/json' \
  --header 'content-type: application/json' \
  --data @account.json

## Retrieve
curl --request GET \
  --url http://{hostname}:7800/v1/accounts/REPLACE_ACCOUNTID \
  --header 'accept: application/json'

## Update
curl --request PUT \
  --url http://{hostname}:7800/v1/accounts/REPLACE_ACCOUNTID \
  --header 'accept: application/json' \
  --header 'content-type: application/json' \
  --data @account.json

## Delete
curl --request DELETE \
  --url http://{hostname}:7800/v1/accounts/REPLACE_ACCOUNTID \
  --header 'accept: application/json'
  
## List
curl --request GET \
  --url http://{hostname}:7800/v1/accounts \
  --header 'accept: application/json'