CREATE COMPUTE MODULE deleteAccount_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Copy headers to preserve HTTP transport context
		CALL CopyMessageHeaders();

		-- 2. Retrieve accountId from the HTTP path parameter
		DECLARE v_AccountId CHARACTER InputLocalEnvironment.REST.Input.Parameters.accountId;
		
		-- 3. Reference Output JSON Data
		CREATE FIELD OutputRoot.JSON.Data;
		DECLARE outputDataRef REFERENCE TO OutputRoot.JSON.Data;
		
		DECLARE DBSchema CHARACTER 'public';	
		DECLARE DBTable  CHARACTER 'accounts';
		
		-- 4. Check if target transaction exists in database
		DECLARE account ROW;
		SET account.Record[] = SELECT
			T.account_id 	AS account_id
		FROM Database.{DBSchema}.{DBTable} AS T
		WHERE T.account_id = v_AccountId;
		
		IF (SQLCODE = 0) THEN
			IF CARDINALITY(transaction.Record[]) > 0 THEN			
			ELSE
			END IF;
		ELSE
			
		END IF;
		
		-- Delete account from PostgreSQL via ODBC datasource MY_PG_DSN
		DELETE FROM Database.{DBSchema}.{DBTable} AS A WHERE A.account_id = v_AccountId;
	
		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;

		IF (SQLCODE = 0) THEN
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '200';
			-- Build JSON response
			SET OutputRoot.JSON.Data.Result = 'Account ' || v_AccountId || ' deleted successfully';
		ELSE
			-- Build JSON response with 500 status
			SET OutputRoot.HTTPResponseHeader."X-Original-HTTP-Status-Code" = '500';
			
            SET OutputRoot.JSON.Data.Result =  
              'The insert failed. The database SQLSTATE was ' || CAST(SQLSTATE AS CHAR) || 
              ' and the SQLCODE was ' || CAST(SQLCODE AS CHAR); 
		END IF;
		RETURN TRUE;
	END;
	
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
